# Variáveis lidas por src/integrations/supabase/client.ts (cliente gerado, hoje sem uso).
# O app usa src/lib/supabase.ts, que tem a URL e a chave pública do projeto no código,
# então o build de produção não depende deste arquivo.
# Para uso local, copie para .env.local (ignorado pelo Git). Só variáveis VITE_* vão
# para o bundle do navegador: nunca coloque segredos aqui.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
